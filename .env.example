# Local development environment for ItemIQ.
# Copy this file to ".env" and change SECRET_KEY before deploying.
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=true
# SQLite for local dev; override with a Postgres URL in production:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/itemiq
DATABASE_URL=sqlite:///./itemiq.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
